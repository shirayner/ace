{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(echo*)",
      "Bash(pwd)",
      "Bash(cd*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(npm*)",
      "Bash(node*)",
      "Bash(jq*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*--data*)",
      "Write(*.env)",
      "Write(*id_rsa*)"
    ]
  },
  "autoMemoryDirectory": "~/.claude/memory/",
  "enabledPlugins": {
    "hookify@claude-plugins-official": true,
    "revealjs@revealjs-skill": true,
    "ace@ace-local": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Check if this bash command could be dangerous or destructive. Command: $ARGUMENTS. If it contains rm -rf, sudo, or modifies system files, respond with 'dangerous'. Otherwise respond with 'safe'."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Check if the file being written contains sensitive information like API keys, passwords, or secrets. File: $ARGUMENTS. If sensitive data found, warn the user and suggest using environment variables."
          }
        ]
      }
    ]
  }
}
