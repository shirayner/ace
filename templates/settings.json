{
  "effortLevel": "xhigh",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Glob",
      "Grep",
      "Skill(*)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__resolve_library_id",
      "mcp__context7__query_docs",
      "Write",
      "Edit",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rmdir /s /q*)",
      "Bash(rd /s /q*)",
      "Bash(del /f /s /q*)",
      "Bash(deltree*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -ffd*)",
      "Bash(git reset --hard*)",
      "Bash(sudo*)",
      "Write(*.env)",
      "Write(*id_rsa*)"
    ],
    "defaultMode": "default",
    "hooks": {
      "PostToolUse": []
    }
  },
  "hooks": {},
  "enabledPlugins": {
    "ace@ace-local": true
  },
  "autoMemoryDirectory": "~/.claude/memory/",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true
}
